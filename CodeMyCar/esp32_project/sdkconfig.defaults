# CodeMyCar ESP32-C6 v2.0 默认配置

# WiFi
CONFIG_CMCAR_WIFI_SSID="Xiaomi_8D22"
CONFIG_CMCAR_WIFI_PASSWORD="13501962513"

# MQTT
CONFIG_CMCAR_MQTT_BROKER_URL="mqtt://192.168.31.120:1883"
CONFIG_CMCAR_MQTT_CLIENT_ID="codemycar_esp32"

# 设备
CONFIG_CMCAR_DEVICE_ID="DEV_1"

# 分区表
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# UART ISR in IRAM
CONFIG_UART_ISR_IN_IRAM=y

# 优化级别
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
