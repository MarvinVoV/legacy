# ESP32-S3-DevKitC-1 / ESP32-S3-WROOM-2-N32R16V.
# Overlay AFTER sdkconfig.defaults. Never use this on a WROOM-1/QSPI board.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_DTR=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_FREERTOS_UNICORE is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_s3.csv"
# CONFIG_CMCAR_VOICE_MODE_COMMAND is not set
CONFIG_CMCAR_VOICE_MODE_CONVERSATION=y
# CONFIG_SR_WN_WN9S_NIHAOXIAOZHI is not set
# CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS is not set
# CONFIG_SR_WN_WN9L_NIHAOXIAOZHI_TTS3 is not set
CONFIG_SR_WN_WN9_XIAOYAXIAOYA_TTS2=y
CONFIG_CMCAR_VOICE_S3_WAKE_MODEL="xiaoyaxiaoya"
CONFIG_CMCAR_VOICE_S3_WAKE_LABEL="小鸭小鸭"
# Use the new model's own threshold until measured against real speech/noise.
CONFIG_CMCAR_VOICE_WAKE_THRESHOLD=0
CONFIG_SR_NSN_NSNET2=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
# CONFIG_CMCAR_VOICE_DENOISE is not set
CONFIG_CMCAR_VOICE_QUEUE_FRAMES=64
CONFIG_CMCAR_VOICE_I2S_BCLK=12
CONFIG_CMCAR_VOICE_I2S_WS=13
CONFIG_CMCAR_VOICE_I2S_DIN=14
# CONFIG_CMCAR_VOICE_I2S_RIGHT_CHANNEL is not set
CONFIG_CMCAR_UART_TX_PIN=4
CONFIG_CMCAR_UART_RX_PIN=5
CONFIG_CMCAR_UART_RX_BUF_SIZE=4096
CONFIG_CMCAR_UART_TX_BUF_SIZE=1024
CONFIG_CMCAR_UART_RINGBUF_SIZE=4096
CONFIG_CMCAR_UART_TX_QUEUE_DEPTH=16
CONFIG_CMCAR_MQTT_BUFFER_SIZE=4096

# Line-level AEC reference: 37dB clipped heavily in measured speech playback.
CONFIG_CMCAR_VOICE_BOARD_REFERENCE_GAIN_DB=12
CONFIG_CMCAR_VOICE_BOARD_REFERENCE_ADC_CHANNEL=2
