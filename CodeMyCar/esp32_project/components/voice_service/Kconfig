menu "Voice Control"

    config CMCAR_VOICE_DENOISE
        bool "Experimental S3 NS during listening (requires A/B validation)"
        depends on IDF_TARGET_ESP32S3
        default n

    config CMCAR_VOICE_QUEUE_FRAMES
        int "Processed PCM queue depth (20ms frames)"
        default 64 if IDF_TARGET_ESP32S3
        default 32
        range 16 96

    config CMCAR_VOICE_CODEC_BOARD
        bool "Use board-specific audio codec (new hardware)"
        default n
        help
            关闭时使用现有 ICS43434 I2S 麦克风（输入 only）。
            新麦克风/功放板到货后，在 voice_codec_board.c 实现
            voice_codec_board_init() 并打开此选项；不要提前假定接线。

    config CMCAR_VOICE_I2S_BCLK
        int "Microphone I2S BCLK GPIO"
        default 12 if IDF_TARGET_ESP32S3
        default 18
        range 0 48

    config CMCAR_VOICE_I2S_WS
        int "Microphone I2S WS GPIO"
        default 13 if IDF_TARGET_ESP32S3
        default 19
        range 0 48

    config CMCAR_VOICE_I2S_DIN
        int "Microphone I2S data input GPIO"
        default 14 if IDF_TARGET_ESP32S3
        default 21
        range 0 48

    config CMCAR_VOICE_I2S_RIGHT_CHANNEL
        bool "Read right I2S slot (otherwise left)"
        default n

    config CMCAR_VOICE_ENABLED
        bool "Enable voice WebSocket upload"
        default y
        help
            启用 I2S 麦克风采集和 WebSocket 推流。
            运行时在串口输入 s + 回车，录一段音频并上传 pyserver。

    config CMCAR_VOICE_WAKE_ENABLED
        bool "Local nihaoxiaozhi wake, one utterance per wake"
        default y
        help
            Detect locally; no audio upload before wake. Use the board profile
            to select one compatible model. Missing model fails closed.

    config CMCAR_VOICE_CONTINUOUS
        bool "Continuous PCM upload; server VAD owns utterance boundaries"
        default y
        help
            Keep the connection open while WiFi is available. No RMS trigger or
            fixed five-second windows. Original triggered mode remains available.

    config CMCAR_VOICE_WS_URL
        string "pyserver WebSocket URL"
        default "ws://192.168.31.120:8000/api/v1/voice/stream"
        help
            pyserver 语音端点，必须和 pyserver 在同一局域网。

    config CMCAR_VOICE_RECORD_SECONDS
        int "Record seconds per trigger"
        default 5
        range 1 10
        help
            每次触发上传的录音长度。

    config CMCAR_VOICE_AUTO_LOOP
        bool "Auto-record loop (no serial trigger)"
        default n
        help
            启动后自动循环录音上传，不需要在串口输入 s。
            适合台架/语音识别联调。

    config CMCAR_VOICE_TRIGGER_RMS
        int "Voice activity trigger RMS"
        default 800
        range 200 20000
        help
            麦克风 RMS 超过该值时自动开始一次录音上传，不需要串口命令。

    config CMCAR_VOICE_LOOP_DELAY_SEC
        int "Delay between auto sessions (s)"
        default 8
        range 2 60
        depends on CMCAR_VOICE_AUTO_LOOP

endmenu
