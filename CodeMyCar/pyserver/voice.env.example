# 复制为 voice.local.env 并填入真实值；voice.local.env 已被 .gitignore 忽略
# 不要提交含真实密钥的文件
CMCAR_BAIDU_SPEECH_APP_ID=
CMCAR_BAIDU_SPEECH_API_KEY=
CMCAR_BAIDU_SPEECH_SECRET_KEY=

# WebRTC人声分类；energy仅用于阈值/旧录音对照。
CMCAR_VOICE_VAD_BACKEND=webrtc
CMCAR_VOICE_VAD_START_TRIGGER_MS=60
CMCAR_VOICE_EXECUTE_COMMANDS=0
# 0 = pyserver 所在电脑不发声；TTS PCM 仍下发给设备/客户端
CMCAR_VOICE_LOCAL_PLAYBACK=0
CMCAR_VOICE_VAD_START_RMS=200
CMCAR_VOICE_VAD_END_RMS=120
CMCAR_VOICE_VAD_PRE_ROLL_MS=500
CMCAR_VOICE_VAD_END_SILENCE_MS=1000
# Local diagnostic recordings are opt-in and bounded per service lifetime.
CMCAR_VOICE_ARCHIVE_CONTINUOUS_SEGMENTS=0
CMCAR_VOICE_ARCHIVE_MAX_SEGMENTS=8
# 调试时将识别内容在Mac读出；播放期间自动门控收音分段
CMCAR_VOICE_SPEAK_RECOGNIZED=0

# LangChain ChatDeepSeek（只把真实值放进 voice.local.env，不要提交）
CMCAR_LLM_API_KEY=
CMCAR_LLM_BASE_URL=https://api.deepseek.com
CMCAR_LLM_MODEL=deepseek-flash
CMCAR_LLM_MODEL_PRO=deepseek-v4-pro
CMCAR_LLM_THINKING=0
CMCAR_LLM_MAX_TOKENS=512
CMCAR_LLM_TEMPERATURE=0.7

# 一次唤醒多轮长会话
CMCAR_VOICE_CONVERSATION_ENABLED=1
CMCAR_VOICE_CONVERSATION_TURN_END_MS=700
CMCAR_VOICE_CONVERSATION_IDLE_S=15
CMCAR_VOICE_CONVERSATION_MAX_S=600
CMCAR_VOICE_CONVERSATION_MAX_TURNS=30
CMCAR_VOICE_CONVERSATION_HISTORY_TURNS=12
CMCAR_VOICE_CONVERSATION_HISTORY_TOKENS=8000
# Phase 2 only; 0 keeps the current half-duplex behavior
CMCAR_VOICE_BARGE_IN=0
