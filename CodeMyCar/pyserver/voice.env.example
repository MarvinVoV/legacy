# 复制为 voice.local.env 并填入真实值；voice.local.env 已被 .gitignore 忽略
# 不要提交含真实密钥的文件
CMCAR_BAIDU_SPEECH_APP_ID=
CMCAR_BAIDU_SPEECH_API_KEY=
CMCAR_BAIDU_SPEECH_SECRET_KEY=

# WebRTC人声分类；energy仅用于阈值/旧录音对照。
CMCAR_VOICE_VAD_BACKEND=webrtc
CMCAR_VOICE_VAD_START_TRIGGER_MS=60
CMCAR_VOICE_EXECUTE_COMMANDS=0
CMCAR_VOICE_LOCAL_PLAYBACK=1
CMCAR_VOICE_VAD_START_RMS=200
CMCAR_VOICE_VAD_END_RMS=120
CMCAR_VOICE_VAD_PRE_ROLL_MS=500
CMCAR_VOICE_VAD_END_SILENCE_MS=1000
# Local diagnostic recordings are opt-in and bounded per service lifetime.
CMCAR_VOICE_ARCHIVE_CONTINUOUS_SEGMENTS=0
CMCAR_VOICE_ARCHIVE_MAX_SEGMENTS=8
# 调试时将识别内容在Mac读出；播放期间自动门控收音分段
CMCAR_VOICE_SPEAK_RECOGNIZED=1
