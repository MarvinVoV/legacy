{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMCAR_POWER_SHUNT_MILLIOHM": "100"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "NoSonar",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMCAR_SONAR_ENABLED": "OFF"
            }
        },
        {
            "name": "NoSonarBaseline",
            "inherits": "NoSonar",
            "cacheVariables": {
                "CMCAR_CPU_MHZ": "250",
                "CMCAR_CPU_CACHE": "OFF",
                "CMCAR_IMU_ASYNC_I2C": "OFF"
            }
        },
        {
            "name": "NoSonar500",
            "inherits": "NoSonar",
            "cacheVariables": {
                "CMCAR_CPU_MHZ": "500",
                "CMCAR_CPU_CACHE": "ON",
                "CMCAR_IMU_ASYNC_I2C": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "NoSonar",
            "configurePreset": "NoSonar"
        },
        {
            "name": "NoSonarBaseline",
            "configurePreset": "NoSonarBaseline"
        },
        {
            "name": "NoSonar500",
            "configurePreset": "NoSonar500"
        }
    ]
}
